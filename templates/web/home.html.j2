<!DOCTYPE html>
{#- Minimal home page (04-01 tracer). 04-03 replaces it with the Figma 25:356 design.
    id="archive" is permanent: every sent email's 지난 호 보기 links to it (04-01 Task 1). #}
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand }}</title>
</head>
<body style="margin: 0; padding: 24px; font-family: 'IBM Plex Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif; color: #222222;">
<h1>{{ brand }}</h1>
<section id="archive">
<h2>지난 호</h2>
{%- if cards %}
<ul>
{%- for c in cards %}
<li><a href="{{ c.href }}">{{ c.date }} ㅣ {{ c.headline }}</a></li>
{%- endfor %}
</ul>
{%- else %}
<p>아직 발행된 호가 없어요.</p>
{%- endif %}
</section>
</body>
</html>
