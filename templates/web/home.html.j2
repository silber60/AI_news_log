{% extends "_base.html.j2" %}
{#- Home page, Figma 25:356 (Website / Subscribe landing). Owner edits kept: no otter banner
    on top of the sample preview, no 바로 써볼 만한 것 card (D-04). The archive section id is
    permanent: every sent email's 지난 호 보기 links to it (04-01 Task 1). #}

{%- macro subscribe_form(form_id) %}
<form class="form-card" id="{{ form_id }}" method="post" action="{{ subscribe_url }}">
<h2>매주 월요일 아침, 메일함으로 받아보세요</h2>
<label for="{{ form_id }}-name">이름</label>
<input type="text" id="{{ form_id }}-name" name="name" placeholder="홍길동" autocomplete="name">
<label for="{{ form_id }}-email">이메일</label>
<input type="email" id="{{ form_id }}-email" name="email" placeholder="이메일 주소" autocomplete="email" required>
<label class="consent"><input type="checkbox" name="consent" value="yes" required> 뉴스레터 수신과 이메일 수집에 동의해요. 언제든 그만 받을 수 있어요.</label>
<button type="submit">무료로 구독하기</button>
<p class="note">메일 아래쪽 링크로 언제든 해지할 수 있어요.</p>
</form>
{%- endmacro %}

{% block style %}
.hero { background: #FFF6F0; padding: 64px 0 72px; }
.hero .tags { font-size: 13px; font-weight: 500; color: #FF6B00; }
.hero h1 { font-size: 40px; font-weight: 700; line-height: 1.3; margin: 14px 0 20px; }
.hero .body { font-size: 16px; line-height: 1.75; color: #444444; }
.hero .art { margin-top: 28px; border-radius: 12px; }
.hero.solo .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.hero.solo .art { margin-top: 0; }
.get { padding: 80px 0; }
.get .head { text-align: center; margin-bottom: 40px; }
.get h2, .sample h2, .archive h2 { font-size: 28px; font-weight: 700; line-height: 1.35; }
.sub { font-size: 15px; color: #808080; margin-top: 8px; }
.cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
.get-card { border: 1px solid #E6E6E6; border-radius: 16px; padding: 28px 28px 32px; text-align: center; }
.get-card.blue { background: #EDF6FF; border-color: #EDF6FF; }
.get-card img { margin: 0 auto 20px; }
.get-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
.get-card p { font-size: 14px; color: #737373; }
.sample { background: #F5F5F5; padding: 80px 0; }
.sample h2 { margin: 10px 0 16px; }
.sample .body { font-size: 16px; line-height: 1.75; color: #444444; margin-bottom: 20px; }
.preview { width: 420px; max-width: 100%; justify-self: end; background: #FFFFFF; border-radius: 16px; padding: 28px; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08); text-decoration: none; }
.preview .brand { font-size: 12px; font-weight: 700; color: #FF6B00; }
.preview .date, .archive-card .date { font-size: 12px; color: #A3A3A3; }
.preview h3 { font-size: 19px; font-weight: 700; line-height: 1.45; margin: 12px 0 16px; }
.preview ol, .archive-card ol { padding-left: 20px; font-size: 14px; color: #444444; }
.preview li + li { margin-top: 6px; }
.preview .link { display: inline-block; margin-top: 20px; }
.archive { padding: 80px 0; }
.archive .head { margin-bottom: 32px; }
.archive-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
.archive-card { display: block; border: 1px solid #E6E6E6; border-radius: 16px; overflow: hidden; text-decoration: none; background: #FFFFFF; }
.archive-card:hover { border-color: #FF6B00; }
.archive-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #E9E9EC; }
.archive-card .text { padding: 20px; }
.archive-card h3 { font-size: 16px; font-weight: 700; line-height: 1.5; margin: 6px 0 12px; }
.archive-card li + li { margin-top: 4px; }
.empty { font-size: 15px; color: #808080; }
.cta { background: #EDF6FF; padding: 80px 0; }
.cta .art { border-radius: 16px; }
.cta h2 { font-size: 28px; font-weight: 700; color: #303A83; margin-top: 24px; }
.cta.solo .row { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
.cta.solo .row > div { width: 100%; max-width: 544px; }
@media (max-width: 767px) {
  .hero { padding: 40px 0 48px; }
  .hero h1 { font-size: 30px; }
  .hero.solo .row, .cards, .archive-list { grid-template-columns: minmax(0, 1fr); }
  .get, .sample, .archive, .cta { padding: 56px 0; }
  .get h2, .sample h2, .archive h2, .cta h2 { font-size: 24px; }
  .preview { justify-self: stretch; width: 100%; }
}
{% endblock %}

{% block content %}
<main>
<section class="hero{% if not subscribe_url %} solo{% endif %}" data-section="hero">
<div class="wrap row">
<div class="hero-copy">
<p class="tags">#매주 월요일 #GitHub star Top 10 #쉽게 풀어 씀</p>
<h1>이번 주 꼭 알아야 할<br>AI 모델, 해달이 골라 드려요</h1>
<p class="body">Hugging Face Papers에 올라온 모델 중 GitHub star를 많이 받은 것만 골라, 무엇을 하는 모델인지 비전공자도 이해하게 풀어 써요. 상업적으로 써도 되는지, 바로 돌려볼 수 있는지도 함께 알려 드려요.</p>
{%- if subscribe_url %}
<img class="art" src="{{ asset }}/otter-banner.jpg" width="544" height="306" alt="모닥불 앞에 앉은 해달">
{%- endif %}
</div>
{%- if subscribe_url %}
{{ subscribe_form("subscribe") }}
{%- else %}
<img class="art" src="{{ asset }}/otter-banner.jpg" width="544" height="306" alt="모닥불 앞에 앉은 해달">
{%- endif %}
</div>
</section>

<section class="get" data-section="what-you-get">
<div class="wrap">
<div class="head">
<h2>매주 이런 걸 받아요</h2>
<p class="sub">한 번 읽으면 이번 주 AI 흐름이 정리돼요</p>
</div>
<div class="cards">
<div class="get-card" data-card="what-you-get">
<img src="{{ asset }}/otter-magnifier.png" width="140" height="140" alt="">
<h3>GitHub star Top 10</h3>
<p>지난주 올라온 모델 중 개발자들이 실제로 관심 갖는 것만 골라요.</p>
</div>
<div class="get-card blue" data-card="what-you-get">
<img src="{{ asset }}/otter-chalkboard.png" width="140" height="140" alt="">
<h3>AI 기술 쉽게 보기</h3>
<p>이번 주 새로 나온 기술 하나를 예시와 함께 쉽게 풀어 설명해요.</p>
</div>
</div>
</div>
</section>

<section class="sample" data-section="sample">
<div class="wrap row">
<div>
<p class="eyebrow">지난 호 미리보기</p>
<h2>이런 메일이 매주 도착해요</h2>
<p class="body">카드마다 한 줄 요약, 쉬운 설명 세 줄, 모델 정보와 활용 아이디어가 들어가요. 스크롤 몇 번이면 이번 주 Top 10을 다 볼 수 있어요.</p>
<a class="link" href="{{ archive_href }}">전체 지난 호 보기 →</a>
</div>
{%- if latest %}
<a class="preview" href="{{ latest.url }}">
<p class="brand">{{ brand }}</p>
<p class="date">{{ latest.date }}</p>
<h3>{{ latest.headline }}</h3>
<ol>
{%- for t in latest.top3 %}
<li>{{ t }}</li>
{%- endfor %}
</ol>
<span class="link">이번 호 읽어 보기 →</span>
</a>
{%- else %}
<div class="preview">
<p class="brand">{{ brand }}</p>
<h3>첫 호를 준비하고 있어요</h3>
<p class="sub">첫 메일이 나가면 그 호를 여기에서 바로 읽을 수 있어요.</p>
</div>
{%- endif %}
</div>
</section>

<section class="archive" id="{{ archive_id }}" data-section="archive">
<div class="wrap">
<div class="head">
<p class="eyebrow">지난 호</p>
<h2>지금까지 보낸 메일</h2>
</div>
{%- if cards %}
<div class="archive-list">
{%- for c in cards %}
<a class="archive-card" href="{{ c.url }}">
{%- if c.image %}
<img src="{{ c.image.url }}" width="{{ c.image.width }}" height="{{ c.image.height }}" alt="{{ c.image_alt }}" loading="lazy">
{%- endif %}
<div class="text">
<p class="date">{{ c.date }}</p>
<h3>{{ c.headline }}</h3>
<ol>
{%- for t in c.top3 %}
<li>{{ t }}</li>
{%- endfor %}
</ol>
</div>
</a>
{%- endfor %}
</div>
{%- else %}
<p class="empty">아직 발행된 호가 없어요.</p>
{%- endif %}
</div>
</section>

<section class="cta{% if not subscribe_url %} solo{% endif %}" data-section="cta">
<div class="wrap row">
<div>
<img class="art" src="{{ asset }}/otter-wave.jpg" width="544" height="306" alt="손을 흔드는 해달">
<h2>다음 주 월요일, 해달이 기다릴게요 👋</h2>
</div>
{%- if subscribe_url %}
{{ subscribe_form("subscribe-bottom") }}
{%- endif %}
</div>
</section>
</main>
{% endblock %}
